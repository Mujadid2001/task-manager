# Neon Postgres connection string.
#
# Create a free database at https://neon.tech (or add the Neon integration from
# the Vercel Marketplace) and paste the pooled connection string here.
#
# The pooled URL is the one to use in serverless environments:
#   postgresql://<user>:<password>@<host>.neon.tech/<database>?sslmode=require
DATABASE_URL=
